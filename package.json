{
  "name": "iptv-cast",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "setup": "npm i && npx cap add android && bash scripts/setup-android.sh",
    "sync": "npx cap sync android",
    "assets": "npx capacitor-assets generate --android",
    "open": "npx cap open android",
    "bundle": "cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.0.0"
  },
  "engines": { "node": ">=22" }
}
